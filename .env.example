# App
APP_NAME=Eleven
APP_ENV=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Private API authentication
# Generate a long random value; never commit your real token.
ELEVEN_API_TOKEN=
OWNER_PROFILE_ID=owner

# SQLite conversation storage
DATABASE_PATH=./data/eleven.db

# Comma-separated frontend origins; do not use "*" with credentials enabled.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional OpenAI-compatible chat-completions provider.
# Keep real credentials only in your local .env or VPS secret store.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45

# Optional live web research for Dustin (Tavily Search API)
# Create a key in your Tavily account; keep it server-side only.
TAVILY_API_KEY=
RESEARCH_MAX_RESULTS=8

# Optional Lucas GitHub coding workspace (fine-grained token: Contents + Pull requests)
GITHUB_TOKEN=
GITHUB_REPOSITORY=SiddharthBairi935/StrangerThings
GITHUB_BASE_BRANCH=main

# Optional read-only Google Drive access for Mike (OAuth drive.readonly scope)
GOOGLE_DRIVE_ACCESS_TOKEN=
